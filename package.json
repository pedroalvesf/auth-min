{
  "name": "auth-min",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true && nest start --watch",
    "dev:clean": "pkill -f 'npm run dev' || true && npm run dev",
    "build": "nest build --tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text-lcov --coverageReporters=cobertura --reporters=default --reporters=jest-junit",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:watch": "npm run test:e2e -- --watch",
    "test:e2e:coverage": "npm run test:e2e -- --coverage",
    "test:e2e:ci": "npm run test:e2e -- --ci --forceExit --reporters=default --reporters=jest-junit --outputFile=test-results/junit.xml",
    "test:all": "npm run test && npm run test:e2e",
    "lint": "npx eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "npx eslint \"{src,test}/**/*.ts\"",
    "lint:report": "mkdir -p eslint-reports && npx eslint \"{src,test}/**/*.ts\" --format html --output-file eslint-reports/eslint-report.html",
    "format": "npx prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "npx prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:generate:test": "prisma generate --schema=./test/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:test": "prisma migrate dev --schema=./test/schema.prisma",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "db:seed": "npm run prisma:generate && npm run prisma:seed",
    "db:reset": "npm run prisma:migrate reset && npm run db:seed",
    "db:setup:test": "npm run prisma:generate:test && npm run prisma:migrate:test",
    "test:setup": "./scripts/setup-test-env.sh",
    "ci:test": "npm run db:setup:test && npm run test && npm run test:e2e:ci",
    "pre-commit": "npm run lint:check && npm run test:coverage && npm run test:e2e",
    "verify": "npm run ci:test"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts",
    "warnings": {
      "warnEnvConflicts": false
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@nestjs/common": "^10.2.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.2.5",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/passport": "^10.0.1",
    "@nestjs/platform-express": "^10.2.5",
    "@nestjs/swagger": "^7.0.0",
    "@prisma/client": "^6.19.0",
    "@types/geoip-lite": "^1.4.4",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.2",
    "geoip-lite": "^1.4.10",
    "jsonwebtoken": "^9.0.2",
    "nest-winston": "^1.10.2",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "winston": "^3.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/node": "^24.5.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "prettier": "^2.8.8",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
