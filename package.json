{
  "name": "auth-min",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true && nest start --watch",
    "dev:clean": "pkill -f 'npm run dev' || true && npm run dev",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:watch": "npm run test:e2e -- --watch",
    "test:e2e:coverage": "npm run test:e2e -- --coverage",
    "test:e2e:ci": "npm run test:e2e -- --ci --forceExit",
    "test:all": "npm run test && npm run test:e2e",
    "prisma:generate": "prisma generate",
    "prisma:generate:test": "prisma generate --schema=./test/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:test": "prisma migrate dev --schema=./test/prisma/schema.prisma",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "db:seed": "npm run prisma:generate && npm run prisma:seed",
    "db:reset": "npm run prisma:migrate reset && npm run db:seed",
    "db:setup:test": "npm run prisma:generate:test && npm run prisma:migrate:test"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^10.2.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.2.5",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/passport": "^10.0.1",
    "@nestjs/platform-express": "^10.2.5",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.17.1",
    "@types/geoip-lite": "^1.4.4",
    "bcrypt": "^5.1.1",
    "cache-manager-ioredis": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.2",
    "geoip-lite": "^1.4.10",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "nest-winston": "^1.10.2",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.16.2",
    "redis": "^5.9.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "winston": "^3.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/node": "^24.5.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "sqlite3": "^5.1.7",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
