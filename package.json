{
  "name": "auth-min",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true && nest start --watch",
    "dev:clean": "pkill -f 'pnpm run dev' || true && pnpm run dev",
    "build": "nest build --tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --forceExit",
    "test:e2e:watch": "pnpm run test:e2e -- --watch",
    "test:all": "pnpm run test && pnpm run test:e2e",
    "lint": "npx eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "npx eslint \"{src,test}/**/*.ts\"",
    "format": "npx prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "npx prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:generate:test": "export $(cat .env.test | grep -v '^#' | xargs) && prisma generate --schema=./test/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:test": "export $(cat .env.test | grep -v '^#' | xargs) && prisma db push --schema=./test/schema.prisma --force-reset",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "db:seed": "pnpm run prisma:generate && pnpm run prisma:seed",
    "db:setup:test": "export $(cat .env.test | grep -v '^#' | xargs) && prisma db push --schema=./test/schema.prisma --force-reset && pnpm run prisma:generate:test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@nestjs/common": "^10.2.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.2.5",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/passport": "^10.0.1",
    "@nestjs/platform-express": "^10.2.5",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "nest-winston": "^1.10.2",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "winston": "^3.18.3",
    "zod": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "bcrypt",
      "prisma",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.5.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.7.0",
    "prettier": "^2.8.8",
    "prisma": "^7.4.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
