{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", {
      "tsconfig": {
        "baseUrl": ".",
        "paths": {
          "@/*": ["src/*"],
          "@/core/*": ["src/core/*"],
          "@/domain/*": ["src/domain/*"],
          "@/infra/*": ["src/infra/*"],
          "@/test/*": ["test/*"]
        }
      }
    }]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "^@/core/(.*)$": "<rootDir>/src/core/$1",
    "^@/domain/(.*)$": "<rootDir>/src/domain/$1",
    "^@/infra/(.*)$": "<rootDir>/src/infra/$1",
    "^@/test/(.*)$": "<rootDir>/test/$1"
  },
  "testTimeout": 30000,
  "maxWorkers": 1,
  "verbose": true,
  "preset": "ts-jest"
}