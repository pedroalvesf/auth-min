pipeline {
  agent any
  
  triggers {
    pollSCM('H/2 * * * *')
  }
  
  options {
    timestamps()
    timeout(time: 20, unit: 'MINUTES')
  }
  
  environment {
    NODE_ENV = 'test'
    CI = 'true'
  }
  
  stages {
    stage('Setup Test Environment') {
      steps {
        echo 'Starting PostgreSQL test database...'
        sh 'docker-compose -f docker-compose.test.yml up -d postgres-test'
        sh 'sleep 10' // Wait for database to be ready
      }
    }
    
    stage('Install Dependencies') {
      steps {
        echo 'Installing dependencies...'
        sh 'npm ci'
      }
    }
    
    stage('Generate Prisma Client') {
      steps {
        echo 'Generating Prisma clients...'
        sh 'npm run prisma:generate'
        sh 'npm run prisma:generate:test'
      }
    }
    
    stage('Setup Database') {
      steps {
        echo 'Setting up test database...'
        sh 'DATABASE_URL="postgresql://auth_test_user:auth_test_password@localhost:8239/auth_test_db" npx prisma db push --skip-generate'
      }
    }
    
    stage('Run Tests') {
      steps {
        echo 'Running all tests...'
        sh 'npm run test'
        sh 'npm run test:e2e'
      }
    }
  }
  
  post {
    always {
      echo 'Stopping test services...'
      sh 'docker-compose -f docker-compose.test.yml down'
      echo 'Pipeline completed!'
    }
    success {
      echo '✅ All tests passed!'
    }
    failure {
      echo '❌ Pipeline failed!'
    }
  }
}